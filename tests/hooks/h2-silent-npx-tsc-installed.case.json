{
 "name": "H2 is silent for npx tsc when typescript is installed",
 "handler": "cmd-guard",
 "cwd": "{TMP}",
 "tmp": {
  "files": {
   ".git": "x",
   "tsconfig.json": "{}",
   "node_modules/typescript/package.json": "{\"name\":\"typescript\",\"version\":\"5.9.2\"}"
  }
 },
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "cwd": "{TMP}",
  "tool_input": {
   "command": "npx tsc --noEmit"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdout": "",
  "maxMs": 250
 }
}
