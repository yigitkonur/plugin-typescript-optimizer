{
 "name": "H2 stays silent for npx -p typescript tsc (it installs the real compiler)",
 "handler": "cmd-guard",
 "cwd": "{TMP}",
 "tmp": {
  "files": {
   ".git": "x",
   "tsconfig.json": "{}"
  }
 },
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "cwd": "{TMP}",
  "tool_input": {
   "command": "npx -p typescript tsc --noEmit"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdout": "",
  "maxMs": 250
 }
}
