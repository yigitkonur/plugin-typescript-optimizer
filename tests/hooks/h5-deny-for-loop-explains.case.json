{
 "name": "H5 denies a shell for loop and points at rg",
 "handler": "agent-guard",
 "cwd": "{WORK}/F01",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "agent_type": "ts-optimize:ts-triager",
  "cwd": "{WORK}/F01",
  "tool_input": {
   "command": "for f in src/*.ts; do rg x $f; done"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "deny"
  },
  "maxMs": 300,
  "stdoutMatches": "use rg or find"
 }
}
