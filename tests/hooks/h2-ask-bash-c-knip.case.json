{
 "name": "H2 asks for bash -c 'npx knip --fix'",
 "handler": "cmd-guard",
 "cwd": "{TMP}",
 "tmp": {
  "files": {
   ".git": "x",
   "tsconfig.json": "{}"
  }
 },
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "cwd": "{TMP}",
  "tool_input": {
   "command": "bash -c 'npx knip --fix'"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "ask"
  },
  "maxMs": 250
 }
}
