{
 "name": "H5 lets ts-architect list findings (they exist once the audit has ingested)",
 "handler": "agent-guard",
 "cwd": "{WORK}/F01",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "agent_type": "ts-optimize:ts-architect",
  "cwd": "{WORK}/F01",
  "tool_input": {
   "command": "ts-opt findings list --json"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "allow"
  },
  "maxMs": 300
 }
}
