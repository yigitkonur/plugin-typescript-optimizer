{
 "name": "H5 allows cut and tr as stdin filters",
 "handler": "agent-guard",
 "cwd": "{WORK}/F01",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "agent_type": "ts-optimize:ts-triager",
  "cwd": "{WORK}/F01",
  "tool_input": {
   "command": "rg -n normalize src | cut -d: -f1 | tr a-z A-Z | sort -u"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "allow"
  },
  "maxMs": 300
 }
}
