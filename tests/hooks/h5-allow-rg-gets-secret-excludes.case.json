{
 "name": "H5 allows rg and prepends RIPGREP_CONFIG_PATH so rg skips secret files",
 "handler": "agent-guard",
 "cwd": "{WORK}/F01",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "agent_type": "ts-optimize:ts-triager",
  "cwd": "{WORK}/F01",
  "tool_input": {
   "command": "rg -nw normalize src"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "allow"
  },
  "stdoutMatches": "RIPGREP_CONFIG_PATH=[^;]*catalog/rg-secrets\\.rc'; rg -nw normalize src",
  "maxMs": 300
 }
}
