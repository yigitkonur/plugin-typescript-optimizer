{
 "name": "H3 denies commit in a command substitution",
 "handler": "commit-guard",
 "cwd": "{TMP}",
 "tmp": {
  "files": {
   ".git": "gitdir: x\n",
   "tsconfig.json": "{}",
   ".ts-optimize/state/open-run": "R1\n",
   ".ts-optimize/runs/R1/run.json": "{\"state\":\"applying\"}"
  }
 },
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "cwd": "{TMP}",
  "tool_input": {
   "command": "echo $(git commit -m x)"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "deny"
  },
  "stdoutMatches": "ts-opt commit",
  "maxMs": 250
 }
}
