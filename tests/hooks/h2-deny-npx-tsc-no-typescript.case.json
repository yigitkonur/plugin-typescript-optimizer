{
 "name": "H2 denies npx tsc when typescript is not installed",
 "handler": "cmd-guard",
 "cwd": "{TMP}",
 "tmp": {
  "files": {
   ".git": "x",
   "tsconfig.json": "{}"
  }
 },
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "cwd": "{TMP}",
  "tool_input": {
   "command": "npx tsc --noEmit"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "deny"
  },
  "stdoutMatches": "tsc@2\\.0\\.4",
  "maxMs": 250
 }
}
