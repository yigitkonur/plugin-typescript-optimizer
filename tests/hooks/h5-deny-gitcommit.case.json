{
 "name": "H5 denies a triager's Bash call (gitcommit)",
 "handler": "agent-guard",
 "cwd": "{WORK}/F01",
 "stdin": {
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "agent_type": "ts-optimize:ts-triager",
  "cwd": "{WORK}/F01",
  "tool_input": {
   "command": "git commit -am hack"
  }
 },
 "expect": {
  "exitCode": 0,
  "stdoutJson": {
   "hookSpecificOutput.permissionDecision": "deny"
  },
  "maxMs": 250
 }
}