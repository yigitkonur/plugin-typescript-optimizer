{
  // Cloudflare Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" }, // trailing comma follows
    ],
  },
  "migrations": [{ "tag": "v1", "new_classes": ["Counter"] }],
  "vars": { "API_URL": "https://api.example.com/v1" }, /* url contains // */
}
