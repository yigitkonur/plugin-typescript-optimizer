{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node10",
    "baseUrl": "src",
    "downlevelIteration": true,
    "lib": ["es2017"],
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist"
  },
  "include": ["src", "scripts", "test"],
  "ts-node": {
    "compilerOptions": { "module": "commonjs" }
  }
}
