{
  "note": "Never read, scan or quote these paths (doc 03 H5 agent-guard denies Read; doc 04 section 1 rule 6). Mini-glob syntax, matched with dot: true against repo-relative or home-relative POSIX paths.",
  "globs": [
    "**/.env*",
    "**/.dev.vars",
    "**/.dev.vars.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.jks",
    "**/*.keystore",
    "**/*.ppk",
    "**/*.kdbx",
    "**/id_rsa*",
    "**/id_dsa*",
    "**/id_ecdsa*",
    "**/id_ed25519*",
    "**/.ssh/**",
    "**/.gnupg/**",
    "**/.npmrc",
    "**/.netrc",
    "**/_netrc",
    "**/.pypirc",
    "**/.git-credentials",
    "**/.htpasswd",
    "**/.aws/credentials",
    "**/.aws/config",
    "**/.config/gcloud/**",
    "**/.azure/**",
    "**/.docker/config.json",
    "**/.kube/config",
    "**/service-account*.json",
    "**/*-credentials.json",
    "**/credentials.json",
    "**/gcloud-service-key.json",
    "**/*.tfvars",
    "**/terraform.tfstate",
    "**/terraform.tfstate.*"
  ]
}
