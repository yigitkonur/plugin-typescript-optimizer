# ripgrep config for plugin subagents (generated from secret-paths.json; tests/hooks.test.mjs keeps it in sync)
--glob=!**/.env*
--glob=!**/.dev.vars
--glob=!**/.dev.vars.*
--glob=!**/*.pem
--glob=!**/*.key
--glob=!**/*.p12
--glob=!**/*.pfx
--glob=!**/*.jks
--glob=!**/*.keystore
--glob=!**/*.ppk
--glob=!**/*.kdbx
--glob=!**/id_rsa*
--glob=!**/id_dsa*
--glob=!**/id_ecdsa*
--glob=!**/id_ed25519*
--glob=!**/.ssh/**
--glob=!**/.gnupg/**
--glob=!**/.npmrc
--glob=!**/.netrc
--glob=!**/_netrc
--glob=!**/.pypirc
--glob=!**/.git-credentials
--glob=!**/.htpasswd
--glob=!**/.aws/credentials
--glob=!**/.aws/config
--glob=!**/.config/gcloud/**
--glob=!**/.azure/**
--glob=!**/.docker/config.json
--glob=!**/.kube/config
--glob=!**/service-account*.json
--glob=!**/*-credentials.json
--glob=!**/credentials.json
--glob=!**/gcloud-service-key.json
--glob=!**/*.tfvars
--glob=!**/terraform.tfstate
--glob=!**/terraform.tfstate.*
