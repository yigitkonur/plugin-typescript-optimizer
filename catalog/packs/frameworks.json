   ],
   "special_exports": {
    "app/**/page.*": [
     "default",
     "generateMetadata",
     "generateStaticParams",
     "metadata",
     "dynamic",
     "dynamicParams",
     "revalidate",
     "fetchCache",
     "runtime",
     "preferredRegion",
     "maxDuration",
     "viewport",
     "generateViewport"
    ],
    "app/**/layout.*": [
     "default",
     "generateMetadata",
     "generateStaticParams",
     "metadata",
     "viewport",
     "generateViewport",
     "dynamic",
     "revalidate",
     "runtime"
    ],
    "app/**/route.*": [
     "GET",
     "POST",
     "PUT",
     "DELETE",
     "PATCH",
     "HEAD",
     "OPTIONS",
     "dynamic",
     "revalidate",
     "runtime",
     "maxDuration",
     "generateStaticParams"
    ],
    "pages/**": [
     "default",
     "getStaticProps",
     "getServerSideProps",
     "getStaticPaths",
     "getInitialProps",
     "config"
    ],
    "middleware.*": [
     "default",
     "middleware",
     "config"
    ],
    "proxy.*": [
     "default",
     "proxy",
     "config"
    ],
    "instrumentation.*": [
     "register",
     "onRequestError"
    ]
   },
