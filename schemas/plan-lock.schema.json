{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/plan-lock@1",
  "title": "plan.lock.json",
  "type": "object",
  "required": [
    "schema",
    "run",
    "approved",
    "plan_sha256",
    "locked_at",
    "amendments"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/plan-lock@1",
      "description": "Schema identifier"
    },
    "run": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}Z-[0-9a-f]{4}$",
      "description": "UTC minute + 4 hex chars"
    },
    "approved": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-\\d{4,}$"
      }
    },
    "plan_sha256": {
      "type": "string",
      "minLength": 1
    },
    "locked_at": {
      "type": "string"
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "ids",
          "by"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-\\d{4,}$"
            }
          },
          "by": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
