{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/plan@1",
  "title": "plan.md front matter",
  "type": "object",
  "required": [
    "schema",
    "run",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/plan@1",
      "description": "Schema identifier"
    },
    "run": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}Z-[0-9a-f]{4}$",
      "description": "UTC minute + 4 hex chars"
    },
    "mode": {
      "enum": [
        "sweep",
        "standard",
        "deep",
        "tsgo"
      ]
    },
    "base_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_estimate_min": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
