{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/envelope@1",
  "title": "ts-opt JSON envelope",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "result",
    "warnings",
    "next_actions",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/envelope@1",
      "description": "Schema identifier"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "description": "any JSON value"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "name",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
