{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/chunk@1",
  "title": "Triage chunk (raw/chunks/Cnn.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "run",
    "domain",
    "package",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/chunk@1",
      "description": "Schema identifier"
    },
    "id": {
      "type": "string",
      "pattern": "^[CS]\\d+$"
    },
    "run": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}Z-[0-9a-f]{4}$",
      "description": "UTC minute + 4 hex chars"
    },
    "domain": {
      "enum": [
        "platform",
        "reachability",
        "types",
        "structure",
        "slop",
        "toolchain"
      ]
    },
    "package": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^c-\\d{4,}$"
      },
      "minItems": 0
    },
    "records": {
      "type": "array",
      "description": "One compact record per candidate (same order as candidates), so a triager needs no lookup in the gitignored raw/ directory",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c-\\d{4,}$"
          },
          "rule": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "snippet": {
            "type": "string"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "context": {
      "type": "object",
      "required": [],
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entry_conventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "verify",
        "structure"
      ]
    }
  },
  "additionalProperties": true
}
