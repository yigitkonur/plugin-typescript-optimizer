{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/fit@1",
  "title": "`ts-opt fit` result (fit.json)",
  "type": "object",
  "required": [
    "schema",
    "verdict",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/fit@1",
      "description": "Schema identifier"
    },
    "verdict": {
      "enum": [
        "already-native",
        "ready",
        "ready-with-bridge",
        "needs-config",
        "blocked",
        "not-applicable",
        "cannot-probe"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "authoritative": {
            "type": [
              "object",
              "string",
              "null"
            ]
          },
          "fast": {
            "type": [
              "object",
              "string",
              "null"
            ]
          },
          "ms": {
            "type": "object",
            "required": [],
            "properties": {
              "auth": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fast": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fast_single": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "diag_equal": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "only_authoritative": {
            "type": "array",
            "items": {}
          },
          "only_native": {
            "type": "array",
            "items": {}
          },
          "removed_options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "option"
              ],
              "properties": {
                "option": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "ecosystem": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "status"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "remedy": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "ci": {
      "type": "array",
      "items": {}
    },
    "cannot_probe_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
