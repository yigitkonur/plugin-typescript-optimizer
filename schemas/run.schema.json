{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ts-optimize/run@1",
  "title": "run.json",
  "type": "object",
  "required": [
    "schema",
    "id",
    "state",
    "mode",
    "created",
    "repo"
  ],
  "properties": {
    "schema": {
      "const": "ts-optimize/run@1",
      "description": "Schema identifier"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}Z-[0-9a-f]{4}$",
      "description": "UTC minute + 4 hex chars"
    },
    "plugin_version": {
      "type": "string"
    },
    "state": {
      "enum": [
        "scanning",
        "triaging",
        "planned",
        "ready",
        "locked",
        "applying",
        "verifying",
        "done",
        "aborted"
      ]
    },
    "mode": {
      "enum": [
        "sweep",
        "standard",
        "deep",
        "tsgo"
      ]
    },
    "created": {
      "type": "string"
    },
    "repo": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "git": {
          "type": "boolean"
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "env": {
      "type": "object",
      "required": [],
      "properties": {
        "node": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "pm": {
          "type": "object",
          "required": [],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "compilers": {
          "type": "object",
          "required": [],
          "properties": {
            "authoritative": {
              "type": [
                "object",
                "null"
              ]
            },
            "fast": {
              "type": [
                "object",
                "null"
              ]
            },
            "api_provider": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "engines": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [],
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_base": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "object",
      "required": [],
      "properties": {
        "run": {
          "type": "array",
          "items": {
            "enum": [
              "platform",
              "reachability",
              "types",
              "structure",
              "slop",
              "toolchain"
            ]
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [],
            "properties": {
              "domain": {
                "type": "string"
              },
              "part": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [],
            "properties": {
              "domain": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": [],
      "properties": {
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cmd"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "cmd": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "timeout_s": {
                "type": "number"
              },
              "variant": {
                "type": "string"
              },
              "ci_env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [],
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "baseline_status": {
          "type": "string"
        },
        "red_baseline": {
          "type": [
            "object",
            "null"
          ]
        },
        "accepted_risk": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "fast_check": {
      "type": "object",
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "disabled_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "divergences": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "findings": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "gated",
              "reverted-partial",
              "skipped"
            ]
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate": {
            "type": [
              "string",
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "approvals": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "locked_at": {
          "type": "string"
        },
        "approved": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-\\d{4,}$"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-\\d{4,}$"
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [],
            "properties": {
              "at": {
                "type": "string"
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F-\\d{4,}$"
                }
              },
              "by": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "applying": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "wave": {
          "type": "string"
        },
        "pass": {
          "type": "integer"
        },
        "finding": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": "string"
        },
        "base": {
          "type": "string"
        }
      }
    },
    "timings_s": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [],
        "properties": {
          "at": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "exit": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "abort_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
